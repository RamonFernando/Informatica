using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Net.Http;
using System.Text;
using System.Threading.Tasks;
using static APIDigimon.Models;
using static APIDigimon.Program;

namespace APIDigimon
{
    internal class Controllers
    {   
        // Busqueda por nombre
        public static async Task<JArray> SearchByName(string name)
        {
            var Url = $"https://digimon-api.vercel.app/api/digimon/name/{name}";
            var response = await client.GetAsync(Url);

            // Validamos la respuesta del servidor
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    return null;
                }
                Console.WriteLine($"Error: Codigo: {response.StatusCode}\n Info: {response.ReasonPhrase}");
                PrintWaitForPressKey();
                return null;
            }
            string stringJson = await response.Content.ReadAsStringAsync();

            // Valida que el Json no empiece con un [corchete] (demuestra que no se ha encontrado el digimon)
            if (!stringJson.TrimStart().StartsWith("["))
            {
                Console.WriteLine("Digimon no encontrado");
                PrintWaitForPressKey();
                return null;
            }

            // Conviertimos el JSON en un array y luego creamos un nuevo array para almacenar los digimons
            JArray arrayJson = JArray.Parse(stringJson);

            return arrayJson;
        }

        // Agrega a la lista de favoritos
        public static List<FavoriteItemList> AddToFavoriteList(string stringJson)
        {
            Console.WriteLine("Desea agregar el Digimon a la lista de favoritos S/N?");
            string inputAnswer = Console.ReadLine();

            if (inputAnswer != "S" && inputAnswer != "s")
            {
                Console.WriteLine("Digimon no agregado a la lista de favoritos");
                PrintWaitForPressKey();
                return favoriteLists;

            }
            // Convierte el JSON en un array
            var array = JArray.Parse(stringJson); // Error examen

            // Convierte el primer elemento del array en un objeto FavoriteItemList
            var digimon = array[0];

            FavoriteItemList atributes = new FavoriteItemList()
            {
                Name = (string)digimon["name"],
                Type = (string)digimon["type"],
                Level = (string)digimon["level"],
            };

            if (favoriteLists.Any(d => d.Name == atributes.Name))
            {
                Console.WriteLine($"El digimon {atributes.Name} ya esta en la lista de favoritos");
                PrintWaitForPressKey();
                return favoriteLists;
            }
            favoriteLists.Add(atributes);
            Console.WriteLine("Digimon agregado a la lista de favoritos");
            PrintWaitForPressKey();
            return favoriteLists;
        }

        // Muestra la lista de favoritos
        public static void ShowFavoriteList()
        {
            Console.WriteLine("Mostrando lista de favoritos");
            Console.WriteLine("====================================");
            if (favoriteLists.Count == 0)
            {
                Console.WriteLine("La lista de favoritos esta vacia");
                PrintWaitForPressKey();
                return;
            }
            int count = 0;
            foreach (var item in favoriteLists)
            {
                Console.WriteLine($"\n{count + 1}ºFavorite:" +
                    $"\n-------------------------" +
                    $"\nName: {item.Name}" +
                    $"\nType: {(item.Type == null ? "Unknown" : item.Type)}" +
                    $"\nNivel: {item.Level}");
            }
            PrintWaitForPressKey();

        }

        // Validar Input
        public static int ValidateInput(string input)
        {
            if (!int.TryParse(input, out int num))
            {
                Console.WriteLine("Opcion no valida");
                PrintWaitForPressKey();
                return -1;
            }
            return num;
        }

        // Print 
        public static void PrintWaitForPressKey()
        {
            Console.WriteLine("\nPresiona cualquier tecla para continuar...");
            Console.ReadKey();
        }

        // Manejo de Excepciones
        public static void HandlerException(Exception ex)
        {
            if (ex is HttpRequestException HttpEx)
            {
                Console.WriteLine($"Error de Peticion HTTP: {HttpEx.Message}\n Info: {HttpEx.HResult}");
                return;
            }
            if (ex is JsonException JsonEx)
            {
                Console.WriteLine($"Error de Lectura JSON: {JsonEx.Message}\n Info: {JsonEx.HResult}");
                return;
            }
            Console.WriteLine($"Error desconocido: {ex.Message}\n Info: {ex.HResult}");
        }
    }
}
