using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

using static PlantillaMenú.APIControllers;
using static PlantillaMenú.MenuControllers;
using static PlantillaMenú.APIFiltersControllers;
using static PlantillaMenú.Models;

namespace PlantillaMenú
{
    internal class APIFavoriteList
    {
        public static List<FavoriteItemList> FavoriteList { get; set; } = new List<FavoriteItemList>();

        public static void Add(int id, NameClassContent objJson) {
            FavoriteList.Add(new FavoriteItemList { Id = id, Content = objJson.Slip.Advice });
        }
        public static void Remove(int id) {
            if (FavoriteList.Contains(id))
                FavoriteList.Remove(id);
        }
        public static void PrintList(List<int> FavoriteList) {
            Console.WriteLine("Lista de favoritos");
            int count = 0;
            foreach (var item in FavoriteList)                
                Console.WriteLine($"{count++}º: {item}");
        }

        public static void AddFavoriteList(NameClassContent objJson, string id)
        {
            Console.WriteLine("Desea Agregar a la Lista API? (S/N)");
            string input = Console.ReadLine();
            if (input.ToUpper() == "S")
            {
                int number = ConverStringToInt(id);
                if(number == -1) {
                    Console.WriteLine("Error. No se agrego a la Lista API");
                    return;
                } 
                
                Add(number);
                Console.WriteLine("Guardado con exito.");
                return;
            }
        }

    }
}
    

