using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Net.Http;

// Importar static
using static PlantillaMenú.MenuControllers;
using static PlantillaMenú.APIControllers;
using static PlantillaMenú.APIFiltersControllers;
using static PlantillaMenú.APIFavoriteList;

namespace PlantillaMenú
{
    internal class Program
    {        
        static async Task Main(string[] args)
        {
            while (true)
            {
                try
                {
                    ShowMenu();
                    int? opc = ValidateInput(Console.ReadLine());
                    string input; int id;
                    switch (opc)
                        {
                            case 1:
                                Console.WriteLine("Mostramos consulta API");
                                await ExecuteHttpRequest(); // ApiControllers
                                WaitForPressKey();
                                break;
                            case 2:
                                Console.WriteLine("Filtramos Id API");
                                await GetRequestWhitFilter(); // ApiFiltersControllers
                                Console.WriteLine("Desea Agregar a la Lista API? (S/N)");
                                string inputAdd = Console.ReadLine();
                                if (inputAdd.ToUpper() == "S") {
                                    
                                    id = ConverStringToInt(inputAdd);
                                    Add(id);
                                    Console.WriteLine("Agregado a la Lista API");
                                return;
                                }
                                Console.WriteLine("No se agrego a la Lista API");
                                WaitForPressKey();
                                break;
                            case 3:
                                Console.WriteLine("Agregamos nombres a la Lista API");
                                Console.Write("Ingrese el Id que desea Guardar: ");
                                input = Console.ReadLine();
                                id = ConverStringToInt(input);
                                Add(id);
                                WaitForPressKey();
                                break;
                            case 4:
                                Console.WriteLine("Eliminamos nombres de la Lista API");
                                input = Console.ReadLine();
                                id = ConverStringToInt(input);
                                Remove(id);
                                WaitForPressKey();
                                break;
                            case 5:
                                Console.WriteLine("Mostramos Lista API");
                                PrintList();
                                WaitForPressKey();
                                break;
                            case 0:
                                ExitMenu();
                                return;
                        }                   
                }
                catch (Exception ex)
                {
                    HandlerException(ex);
                }
            }
        }

        
    }
}
