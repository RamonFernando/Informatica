using System;
using System.Collections.Generic;
using System.Linq;
using System.Net.Http;
using System.Text;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

namespace AdvideAPI_Simple
{
    internal class AdviceControlers
    {
        static readonly HttpClient client = new HttpClient();
        public static async Task GetRequestMethod()
        {
            try
            {
                // 1. Peticion GET
                HttpResponseMessage response = await GetRequest(GetUrl());
                // 2. Valicacion servidor 
                Console.WriteLine(ValidationServerRequest(response));

                // 3. Obtenemos el JSON
                string stringJson = await GetJson(response);
                
                // 4. Deserializamos y formateamos
                JObject ObjectJson = JObject.Parse(stringJson);
                string printJson = JsonConvert.SerializeObject(ObjectJson, Formatting.Indented);

                // 5. Imprimir (print)
                Console.WriteLine(printJson);


            }
            catch(Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        public static string GetUrl() => "https://api.adviceslip.com/advice";
        public static async Task<HttpResponseMessage> GetRequest(string url) =>
            await client.GetAsync(GetUrl());
        public static string ValidationServerRequest(HttpResponseMessage response)
        {
            if (!response.IsSuccessStatusCode)
            {
                return $"Error de la peticion HTTP: \nCodigo: {response.StatusCode}\nInfo: {response.ReasonPhrase}";
            }
            return "OK";
        }
        public static async Task<string> GetJson(HttpResponseMessage response) =>
            await response.Content.ReadAsStringAsync();
