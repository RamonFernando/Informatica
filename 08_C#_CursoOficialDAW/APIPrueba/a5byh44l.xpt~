using APIControler;
using System.Xml;

namespace APIPrueba
{
    public class Program
    {
        public static async Task Main(string[] args)
        {   
            while (true) {
                Console.Clear();
                Console.WriteLine("=========================");
                Console.WriteLine("  API de Rick and Morty");
                Console.WriteLine("=========================");
                Console.WriteLine("1.- Listar GET");
                Console.WriteLine("2.- Buscar PUT");
                Console.WriteLine("0.- Salir");
                Console.WriteLine("=======================");
                Console.Write("Elige una opcion: ");
                int opc = Convert.ToInt32(Console.ReadLine());

                switch (opc) {
                    case 1:
                        Console.WriteLine("Ejemplo de uso de la API de Rick and Morty Peticion: GET\n");
                        await CharacterControler.GetCharacters(1);

                        Console.WriteLine("Presiona cualquier tecla para continuar...");
                        Console.ReadKey();
                        break;
                    case 2:
                        Console.WriteLine("Introduce el ID del personaje: ");
                        int id = Convert.ToInt32(Console.ReadLine());
                        await CharacterControler.SearchID(id);
                        break;
                    case 0:
                        Console.WriteLine("Saliendo del programa...");
                        Environment.Exit(0);
                        break;
                    default:
                        Console.WriteLine("Opcion no valida");
                        break;
                }
            }


            //Console.WriteLine("Ejemplo de uso de la API de Rick and Morty Peticion: GET\n");
            // await CharacterControler.GetCharacters(1);


            
            Console.ReadKey();
        }
    }
}