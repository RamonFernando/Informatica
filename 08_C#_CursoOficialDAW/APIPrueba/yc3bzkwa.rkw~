using APIModel;
using Newtonsoft.Json;
using System.Net.Http;

namespace APIControler
{
    public class CharacterControler
    {   /**
         * Realiza una petición asincrona para obtener la lista de personajes
         * 
         **/
        static async void GetCharacters(int page)
        {
            HttpClient client = new HttpClient();
            string utl = $"https://rickandmortyapi.com/api/character?page={page}";

            try
            {
                HttpResponseMessage response = await client.GetAsync(utl);

                response.EnsureSuccessStatusCode();
                Console.WriteLine((response.StatusCode == System.Net.HttpStatusCode.OK
                        ? "OK" : "Error " + response.StatusCode));

                string content = await response.Content.ReadAsStringAsync();

                GetListCharacters(content);
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }

        }
        /**
         * Obtiene la lista de personajes
         * return Lista de personajes
         **/
        private static List<Character> GetListCharacters(string content)
        {
            List<Character> characters = new List<Character>();

            characters = JsonConvert.DeserializeObject<List<Character>>(content);

            foreach (var character in characters)
            {
                Console.WriteLine(character.Name);
            }

            return characters;
        }


    }
}
